{
  "name": "@ai-scanner/api",
  "version": "1.0.0",
  "description": "Express.js REST API for ai.scanner document approval workflow",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js",
    "start": "node dist/index.js",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "node-pg-migrate": "^7.0.2",
    "pino": "^8.16.0",
    "pino-http": "^8.5.0",
    "redis": "^4.6.10",
    "cors": "^2.8.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/cors": "^2.8.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
