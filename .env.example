# Database Configuration
# PostgreSQL connection string for storing document metadata, users, and analysis results
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_scanner

# Redis Configuration
# Redis connection string for queue management and session caching
REDIS_URL=redis://localhost:6379

# AI Configuration
# Google Gemini API key for document analysis (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Email Configuration
# SMTP server settings for sending batch notification emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Authentication Configuration
# RS256 key pair for JWT signing (generate with scripts/generate-keys.sh)
# Format: PEM encoded private and public keys (use literal \n for newlines)
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----

# File System Configuration
# Absolute path to network share where scanned files are deposited
SCAN_FOLDER_PATH=/path/to/network/share/scanned-docs

# Base path for destination folders (where approved documents are moved)
OUTPUT_FOLDERS_BASE=/path/to/network/share/output-folders

# Web UI Configuration
# Base URL for frontend (used in email links for review workflow)
WEB_UI_BASE_URL=http://localhost:3000
